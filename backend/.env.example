# Fake Media Detector — Backend Configuration
# Copy this file to .env and modify as needed.

# Server network settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Pretrained Hugging Face Vision Transformer model
# Primary: Organika/sdxl-detector
# Fallbacks: dima806/deepfake_vs_real_image_detection, prithivMLmods/Deep-Fake-Detector-Model
AI_MODEL_NAME=Organika/sdxl-detector

# SQLite perceptual hash database file path
HASH_DB_PATH=data/hashes.db

# Evaluation benchmark results export path
EVAL_RESULTS_PATH=data/eval_results.csv

# Permitted CORS origins for web clients (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional: Run live Hugging Face inference test during pytest (1 to enable)
RUN_MODEL_TESTS=0
